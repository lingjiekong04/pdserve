+@app.post("/pdserve/cancel")
+async def pdserve_cancel(obj: AbortReq, request: Request):
+    """Queue an exact-ID cooperative cancel; cleanup is confirmed separately."""
+    if not all(os.getenv(flag, "0") == "1" for flag in
+               ("PDSERVE_ENGINE_CANCEL", "PDSERVE_ENGINE_LIFECYCLE", "PDSERVE_ENGINE_OBSERVER")):
+        return ORJSONResponse({"error": "PDServe cooperative cancellation requires observer and lifecycle"}, status_code=503)
+    if not obj.rid or len(obj.rid) > 128:
+        return ORJSONResponse({"error": "rid must contain 1 to 128 characters"}, status_code=400)
+    manager = _global_state.tokenizer_manager
+    manager.auto_create_handle_loop()
+    issued_ns = time.monotonic_ns()
+    manager.send_to_scheduler.send_pyobj(AbortReq(obj.rid, pdserve_issued_ns=issued_ns))
+    return ORJSONResponse({"rid": obj.rid, "cancel_enqueued": True, "issued_ns": issued_ns,
+                          "cleanup_confirmed": False, "mode": "drain_prefill_and_transfer"}, status_code=202)
+
